import React, { useState } from "react";
import { SafeAreaView, Text, Button, View, StyleSheet } from "react-native";

const BACKEND = "http://YOUR_BACKEND:5000"; 
// 🔴 replace YOUR_BACKEND with your backend URL

export default function Simulate() {
  const [last, setLast] = useState(null);

  const sendCritical = async () => {
    const fakeData = {
      species: "human",
      heart_rate: 140,
      spo2: 82,
      temperature: 39.5,
      resp_rate: 28
    };

    try {
      const res = await fetch(`${BACKEND}/predict`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(fakeData)
      });
      const json = await res.json();
      setLast(json);
    } catch (e) { console.log(e); }
  };

  return (
    <SafeAreaView style={styles.container}>
      <Text style={styles.title}>Simulate Critical Event</Text>
      <Button title="Trigger Event" onPress={sendCritical} />
      {last && (
        <View style={styles.card}>
          <Text style={{ fontWeight: "700" }}>Last Simulation:</Text>
          <Text>Input → {JSON.stringify(last.input)}</Text>
          <Text>Prediction → {last.event_prediction === 1 ? "ALERT" : "OK"}</Text>
        </View>
      )}
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 20, backgroundColor: "#fff" },
  title: { fontSize: 22, fontWeight: "700", marginBottom: 12 },
  card: { marginTop: 20, padding: 12, borderWidth: 1, borderRadius: 8, backgroundColor: "#f9f9f9" }
});
